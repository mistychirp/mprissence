# Copy to ~/.config/systemd/user/ and run:
#   systemctl --user enable --now mprissence
[Unit]
Description=Discord rich presence for MPRIS media players
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.cargo/bin/mprissence
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
